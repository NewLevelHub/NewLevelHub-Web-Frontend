# Production environment variables
# Copy to .env.production on the production server and fill in values
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=NewLevelHub
VITE_IDLE_SESSION_TIMEOUT_MINUTES=30
VITE_IDLE_SESSION_WARNING_MINUTES=2
# Must match backend ABSOLUTE_SESSION_TIMEOUT_MINUTES
VITE_ABSOLUTE_SESSION_TIMEOUT_MINUTES=480
VITE_ABSOLUTE_SESSION_WARNING_MINUTES=2
